{
  "name": "blade-components",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-tokens": "npx tsx src/tokens/figmaSyncTokens.ts",
  "dev": "npm run generate-tokens && vite",
    "build": "npm run generate-tokens && tsc && vite build",
    "sync-tokens": "npx tsx src/tokens/figmaSyncTokens.ts",
    "preview": "vite preview",
    "mcp:watch": "node .mcp/watch.js",
    "dev:mcp": "concurrently \"npm run dev\" \"npm run mcp:watch\"",
    "mcp:start": "echo \"Start your MCP server here (see .mcp/config.json)\"",
    "build:tokens": "ts-node src/tokens/figmaSyncTokens.ts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^10.0.5",
    "sass": "^1.105.1",
    "sass-embedded": "^1.105.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^5.1.6",
    "vite": "^5.0.0"
  }
}
